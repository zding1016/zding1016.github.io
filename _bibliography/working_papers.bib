@unpublished{ding2025dynamic,
  title = {Dynamic Policy Evaluation under Selective Labels: Evidence from Human and Algorithmic Decision-Making in Sequential Allocation},
  author = {Ding, Ziqian and Jiang, Zoey and Singh, Param Vir},
  year = {2025},
  note = {Working paper},
  abstract = {Evaluating sequential decision-making is challenging when outcomes are observed only for chosen actions, creating a selective labels problem that is compounded in dynamic settings where decisions influence future information and learning. This paper studies how to compare human and algorithmic policies in such environments using observational data, focusing on settings where decisions must balance exploration and exploitation over time. We apply this framework to biomedical innovation, modeling scientists’ trial allocation decisions as a combinatorial contextual bandit with delayed feedback using data from over 700,000 experiments in the Protein Structure Initiative. Benchmarking human decisions against a neural upper confidence bound algorithm, we find that the algorithm achieves approximately 18\% more successful project completions under comparable constraints. We find that human decision-makers systematically overestimate success probabilities and allocate effort too diffusely across projects, leading to inefficient exploration. Correcting prediction errors accounts for the majority of the performance gap, while improvements in exploration behavior provide additional gains. This paper contributes a general framework for evaluating dynamic policies under selective labels and provides large-scale empirical evidence that algorithmic policies can outperform human experts in complex sequential allocation tasks.},
  html = {https://zding1016.github.io/dynamic-policy-evaluation.html},
  pdf = {https://zding1016.github.io/dynamic-policy-evaluation.pdf},
  website = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5587814}
}
